<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The app validates destinations as private LAN or Tailscale hosts before loading HTTP. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
